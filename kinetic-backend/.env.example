# ─────────────────────────────────────────────
#  kinetic-backend — variáveis de ambiente
#  Copie este arquivo para `.env` e preencha os valores.
#    cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
#  O `.env` NÃO é versionado.
# ─────────────────────────────────────────────

# ─── Banco de dados (PostgreSQL / Supabase) ──
# URL JDBC do PostgreSQL (ex.: pooler do Supabase)
DB_URL=jdbc:postgresql://localhost:5432/postgres
# Usuário do banco (no Supabase: postgres.<project-id>)
DB_USERNAME=postgres
# Senha do banco (use aspas se houver caracteres especiais)
DB_PASSWORD="your-database-password"

# ─── JWT ─────────────────────────────────────
# Segredo p/ assinar os tokens — base64, >= 256 bits.
# Gere um aleatório com: openssl rand -base64 64
JWT_SECRET=change-me-to-a-base64-secret-of-at-least-256-bits
# Validade do access token, em milissegundos (ex.: 86400000 = 24h)
JWT_EXPIRATION_MS=86400000
# Validade do refresh token, em milissegundos (ex.: 2592000000 = 30 dias)
JWT_REFRESH_EXPIRATION_MS=2592000000

# ─── Supabase Storage (upload de fotos do feed social) ─
# Base do projeto Supabase (mesma do banco). Ex.: https://<project-id>.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co
# service_role secret key (Project Settings → API). NÃO use a anon. Fica só no backend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Nome do bucket PÚBLICO criado no Storage.
SUPABASE_STORAGE_BUCKET=social-media
# Validade (segundos) das URLs assinadas de mídia. O bucket deve ser PRIVADO.
SUPABASE_SIGNED_URL_TTL_SECONDS=900

# ─── Google Gemini (geração de treinos por IA) ─
GOOGLE_AI_API_KEY=your-google-gemini-api-key

# ─── CORS (opcional) ─────────────────────────
# Origens liberadas, separadas por vírgula.
# Default: http://localhost:8081,http://localhost:19006
# CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# ─── Resend (e-mail do código de recuperação de senha) ─
# API key da Resend (https://resend.com/api-keys). Fica só no backend.
RESEND_API_KEY=
# Remetente. Precisa ser de um domínio verificado na Resend (ex.: Kinetic <nao-responda@seudominio.com>).
# Sem domínio verificado, use onboarding@resend.dev, que só entrega para o e-mail dono da conta Resend.
RESEND_FROM_EMAIL=Kinetic <onboarding@resend.dev>
# Só para desenvolvimento: true escreve o texto dos e-mails (com o código) no log do backend,
# para testar recuperação de senha e confirmação de e-mail sem receber o e-mail. Nunca em produção.
# DEV_LOG_EMAIL_CONTENT=false

# ─── Cobrança do personal (assinatura do Kinetic) ─
# "demo" (padrão): nenhuma cobrança real; o painel simula o pagamento.
# "asaas": usa a API do Asaas (precisa das variáveis abaixo).
# BILLING_GATEWAY=demo
# Dias de teste grátis para personal novo (até 5 alunos).
# BILLING_TRIAL_DAYS=14
# Sandbox: https://sandbox.asaas.com/api/v3 · Produção: https://api.asaas.com/v3
# ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# Chave da API (Asaas → Integrações → Chave de API). Fica só no backend.
# ASAAS_API_KEY=
# Token que você define ao criar o webhook no Asaas (URL: <backend>/api/webhooks/asaas).
# ASAAS_WEBHOOK_TOKEN=

# Loga cada query do Hibernate (deixa o backend lento; só para depurar)
SHOW_SQL=false
