# HTTPS da API na VM: Cloudflare (proxy laranja) → Caddy :443 → backend:8080.
# Certificado: "Origin Certificate" da Cloudflare (SSL/TLS → Origin Server), com o
# modo SSL/TLS em "Full (strict)". Os arquivos ficam em caddy/certs/ (fora do git).
#
# Faixas de IP da Cloudflare: https://www.cloudflare.com/ips/ (conferir de tempos em tempos).

{
	servers {
		# Só confia no CF-Connecting-IP quando a conexão vem da Cloudflare.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

api.kineticfitness.com.br {
	tls /certs/origin.pem /certs/origin.key

	# Quem tenta falar direto com o IP da VM, sem passar pela Cloudflare, é derrubado.
	# Assim ninguém pula o WAF/rate limit da Cloudflare nem forja o CF-Connecting-IP.
	@direct not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	abort @direct

	reverse_proxy backend:8080 {
		# IP real do usuário para o rate limit do backend (lido pelo Tomcat com
		# server.forward-headers-strategy=native).
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}

	encode gzip
}
