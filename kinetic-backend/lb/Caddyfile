# Balanceador entre as cópias do backend. Só HTTP e só dentro da máquina: o HTTPS
# fica com a Cloudflare, e o cloudflared entrega em localhost:8080.
{
	admin off
	servers {
		# Mantém o X-Forwarded-For que o cloudflared manda (ele chega pela rede interna
		# do Docker) e acrescenta o próprio salto; o backend tira dali o IP real.
		trusted_proxies static private_ranges
	}
}

:8080 {
	reverse_proxy backend-1:8080 backend-2:8080 {
		lb_policy round_robin
		# Cópia parando ou subindo recusa a conexão: tenta a outra em vez de dar erro.
		lb_try_duration 10s
		lb_try_interval 250ms
		health_uri /health
		health_interval 2s
		health_timeout 2s
	}
}
