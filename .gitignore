# ─────────────────────────────────────────────
#  Kinetic App — .gitignore
#  React Native + Expo + Node.js
# ─────────────────────────────────────────────

# ─── Dependências Node ───────────────────────
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# Lockfiles dos subprojetos são versionados (build reprodutível); só o da raiz,
# que não tem package.json, é lixo.
/package-lock.json
# yarn.lock           # opcional: descomente se usar Yarn

# ─── Expo ────────────────────────────────────
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# ─── Build React Native ──────────────────────
android/
ios/
*.apk
*.aab
*.ipa
*.jks
*.keystore
*.p12
*.mobileprovision

# ─── Variáveis de Ambiente (NUNCA versionar) ─
.env
.env.local
.env.development
.env.staging
.env.production
.env.*
# template versionado (sem segredos) — exceções ao ignore acima
!.env.example
!**/.env.example

# ─── Dados Sensíveis / Chaves ────────────────
*.pem
*.key
*.cert
*.p8
google-services.json
GoogleService-Info.plist
*secret*
*credentials*

# ─── Cache e Temporários ─────────────────────
.cache/
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db

# ─── Metro Bundler ───────────────────────────
.metro-health-check-result

# ─── Editores e IDEs ─────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/*.log
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.orig

# ─── TypeScript ──────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ─── Testes ──────────────────────────────────
coverage/
.nyc_output/
jest-results/

# ─── Sistema Operacional ─────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ─── Pastas de contexto interno / AI ─────────
.gemini/
**/target/
.vscode/*
!.vscode/settings.json
.github/
.agents/

.claude/

# ─── Supabase CLI (estado local, inclui o project ref) ─
supabase/.temp/
supabase/.branches/

# ==========================================
# Graphify (Mapeamento do Projeto)
# ==========================================

# Ignorar arquivos estritamente locais do Graphify
graphify-out/manifest.json
graphify-out/cost.json

# (Opcional) Ignorar o cache para manter o repositório menor
graphify-out/cache/

# Ignorar o cofre do Obsidian/Wiki gerado para leitura local
graphify-out/obsidian/
graphify-out/.obsidian/

# Ignorar todos os arquivos de estado intermediário (arquivos ocultos .json)
graphify-out/.*.json
graphify-out/.graphify_root
graphify-out/.graphify_*.sig
graphify-out/.graphify_*.txt

# Snapshots datados de execuções anteriores (backup local, regeneráveis)
graphify-out/20*/

# Visualização gerada a partir do graph.json (~5 MB, regenerável)
graphify-out/graph.html

# Estado do graphify gravado na raiz (caminho do Python é desta máquina)
/.graphify_*
security-audit-skill
